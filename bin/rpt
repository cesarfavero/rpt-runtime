#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CMD="${1:-}"
shift || true

case "$CMD" in
  run)
    exec python "$ROOT_DIR/runtime/run_triton_inference.py" "$@"
    ;;
  native)
    exec python "$ROOT_DIR/runtime/run_native_inference.py" "$@"
    ;;
  hybrid)
    exec python "$ROOT_DIR/runtime/run_inference.py" "$@"
    ;;
  ""|-h|--help|help)
    cat <<USAGE
rpt commands:
  rpt run --model-dir /path/to/MODEL_DIR --prompt "..."
  rpt native --model-dir /path/to/MODEL_DIR --prompt "..."
  rpt hybrid --model-dir /path/to/MODEL_DIR --prompt "..."
USAGE
    ;;
  *)
    echo "Unknown command: $CMD" >&2
    exit 1
    ;;
esac
